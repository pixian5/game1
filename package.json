{
  "name": "neon-heart-game",
  "private": true,
  "version": "0.6.8",
  "scripts": {
    "test:regressions": "node test_regressions.js",
    "test:story": "node test_story.js",
    "test:browser": "playwright test",
    "validate:story": "node validate_story.js",
    "check:version": "node check_version.js",
    "test:all": "npm run check:version && npm run validate:story && npm run check:ui && npm run lint && npm run test:regressions && npm run test:story && npm run test:browser",
    "serve": "node test_server.js",
    "check:ui": "node check_ui.js",
    "lint": "eslint .",
    "test:cov": "c8 --include \"engine.js\" --include \"engine_*.js\" --include \"interaction_queue.js\" --include \"save_migrations.js\" --reporter=lcov node test_engine_direct.mjs && node tools/check_coverage.mjs",
    "flow:test": "node tools/flow_test.mjs",
    "soak:test": "node tools/soak_test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "c8": "^12.0.0",
    "eslint": "^10.13.0"
  }
}
