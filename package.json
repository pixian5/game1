{
  "name": "neon-heart-game",
  "private": true,
  "version": "0.9.9",
  "scripts": {
    "test:regressions": "node test_regressions.js",
    "test:story": "node test_story.js",
    "test:account": "playwright test playwright/account.spec.js --project=chromium",
    "test:browser": "playwright test --grep-invert \"账号与云存档\"",
    "validate:story": "node validate_story.js",
    "check:version": "node check_version.js",
    "test:all": "npm run check:version && npm run validate:story && npm run check:ui && npm run lint && npm run test:regressions && npm run test:story && npm run test:route && npm run matrix:route && npm run test:account-api && npm run test:account && npm run test:browser",
    "serve": "node test_server.js",
    "check:ui": "node check_ui.js",
    "lint": "eslint .",
    "test:cov": "c8 --include \"engine.js\" --include \"engine_*.js\" --include \"interaction_queue.js\" --include \"save_migrations.js\" --reporter=lcov node test_engine_direct.mjs && node tools/check_coverage.mjs",
    "flow:test": "node tools/flow_test.mjs",
    "soak:test": "node tools/soak_test.mjs",
    "test:route": "node test_route_timing.mjs",
    "matrix:route": "node tools/route_matrix.mjs",
    "probe:finale": "node tools/finale_gate_probe.mjs",
    "verify:offline": "npm run check:version && npm run validate:story && npm run check:ui && npm run test:regressions && npm run test:story && npm run test:route && npm run matrix:route && npm run test:account-api",
    "serve:account": "node server/index.mjs",
    "test:account-api": "node server/test_api.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "c8": "^10.1.3",
    "eslint": "^10.13.0"
  }
}
