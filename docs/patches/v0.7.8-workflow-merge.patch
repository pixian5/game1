diff --git a/.github/workflows/reusable-verify.yml b/.github/workflows/reusable-verify.yml
new file mode 100644
index 0000000..66f9f42
--- /dev/null
+++ b/.github/workflows/reusable-verify.yml
@@ -0,0 +1,20 @@
+name: 轻量校验（可复用）
+
+# v0.7.8：从 deploy-server / deploy-hf 抽出的公共校验步骤（npm ci + 版本一致性 + 剧情数据）。
+# 重测试（lint/回归/覆盖率/E2E）由测试工作流并行执行，部署工作流只做发布门禁。
+on:
+  workflow_call:
+
+jobs:
+  verify:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 20
+          cache: npm
+      - run: npm ci
+      - run: npm run check:version
+      - run: npm run validate:story
